# Copiá este archivo como .env para que `npm run dev` use servicios reales.
# Sin .env, el servidor local usa una base y una carpeta de archivos propias
# (.data/) y no necesita ninguna cuenta. Nunca subas el .env al repositorio.

# Postgres (Supabase): Settings → Database → Connection string (pooler)
DATABASE_URL=

# Supabase: Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mails que pueden entrar al panel, separados por coma
OWNER_EMAILS=

# Frase larga al azar (firma la sesión del panel y los enlaces de pedido)
SESSION_SECRET=

# Mercado Pago (Checkout Pro): Tus integraciones → Credenciales
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Dirección pública, si hace falta (enlaces de vuelta de Mercado Pago)
PUBLIC_URL=

# Envíos: CP desde donde se despacha
SHIPPING_ORIGIN_CP=5000
# Correo Argentino (API MiCorreo)
MICORREO_USER=
MICORREO_PASSWORD=
MICORREO_CUSTOMER_ID=
# Andreani (clientes con contrato)
ANDREANI_CONTRATO=
ANDREANI_CLIENTE=
ANDREANI_USER=
ANDREANI_PASSWORD=

# Mails de los pedidos (Resend). Sin la clave no se manda nada.
RESEND_API_KEY=
MAIL_FROM=nevrado <pedidos@nevrado.com>
MAIL_REPLY_TO=
